<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!--Roslyn Analyzer Configuration-->
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>

        <!-- 
            RS2008 is a Release Tracking warning from Microsoft.CodeAnalysis.Analyzers
            that requires AnalyzerReleases.Shipped.md / AnalyzerReleases.Unshipped.md files.
            It is not applicable for internal generators shipped inside another package.
        -->
        <!--<NoWarn>
        $(NoWarn);
        RS2008
        </NoWarn>-->
    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>
</Project>