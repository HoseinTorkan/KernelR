<Project Sdk="Microsoft.NET.Sdk">

    <!-- ═══════════════════════════════════════════ -->
    <!-- Package Identity                           -->
    <!-- ═══════════════════════════════════════════ -->
    <PropertyGroup>
        <PackageId>KernelR.Primitives</PackageId>
        <Title>KernelR Primitives</Title>

        <!-- ═══════════════════════════════════════════ -->
        <!-- Versioning Strategy (.NET-aligned SemVer)  -->
        <!-- ═══════════════════════════════════════════ -->
        <!--
            This project follows .NET-aligned SemVer 2.0:

              MAJOR = Target .NET major version (e.g., 10 for .NET 10)
              MINOR = Feature release within that .NET line
              PATCH = Bug fixes

            Examples:
              10.0.0        → first release for .NET 10
              10.0.1        → bug fix
              10.1.0        → new features (backward compatible)
              10.99.0       → deprecation warning (prelude to 11.0.0)
              10.1.0-beta.1 → pre-release of 10.1.0
              11.0.0        → first release for .NET 11 (or a breaking change)

            See docs/VERSIONING.md for the full policy.
        -->
        <Version>10.0.0</Version>

        <!--
            AssemblyVersion is used by the CLR for assembly binding.
            It only changes when a breaking API change is introduced.
            Format: MAJOR.0.0.0 (MINOR and PATCH never appear here).
            This prevents "DLL hell" for consumers who use strong-named assemblies.
        -->
        <AssemblyVersion>10.0.0.0</AssemblyVersion>

        <!--
            FileVersion appears in Windows Explorer file properties.
            It carries the full version and matches the PackageVersion.
        -->
        <FileVersion>10.0.0.0</FileVersion>

        <!--
            InformationalVersion is displayed by `dotnet info` and included in
            assembly metadata. In CI, override it with the commit SHA:
              dotnet pack -p:InformationalVersion=10.0.0+abc1234
        -->
        <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Package Metadata                           -->
    <!-- ═══════════════════════════════════════════ -->
    <PropertyGroup>
        <Description>
            Foundational primitives for KernelR. Provides the Result pattern,
            Error modeling with strongly-typed categories, and shared JSON
            serialization contracts for DDD and clean-architecture applications.

            This package has zero dependencies and is fully compatible with
            Native AOT and Trimming.
        </Description>

        <PackageTags>result;result-pattern;patterns;primitives;ddd;clean-architecture;error-handling;functional;aot;trimming</PackageTags>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════ -->
    <!-- AOT & Trimming Support                     -->
    <!-- ═══════════════════════════════════════════ -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Packing Configuration                      -->
    <!-- ═══════════════════════════════════════════ -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Files Packed into NuGet Package            -->
    <!-- ═══════════════════════════════════════════ -->
    <ItemGroup>
        <!-- README from /docs folder at the repository root -->
        <None Include="..\..\docs\KernelR.Primitives\README.md"
              Pack="true"
              PackagePath="README.md"
              Condition="Exists('..\..\docs\KernelR.Primitives\README.md')" />
    </ItemGroup>

</Project>