<Project Sdk="Microsoft.NET.Sdk">

    <!-- ═══════════════════════════════════════════ -->
    <!-- Package Metadata                           -->
    <!-- ═══════════════════════════════════════════ -->
    <PropertyGroup>
        <!-- Unique identifier for the NuGet package -->
        <PackageId>KernelR.Domain</PackageId>

        <!-- Manually managed semantic version -->
        <Version>1.0.0</Version>

        <!-- Detailed description displayed on NuGet.org -->
        <Description>
            Foundational building blocks for Domain-Driven Design (DDD) and
            Clean Architecture in .NET. Provides a rich set of value objects
            (PhoneNumber, Email, Money, CurrencyCode, NationalCode, PersonName,
            Url, Size, DataSize) with built-in validation via the Result
            pattern, plus entities, aggregate roots, strongly-typed identifiers,
            auditing contracts, repositories, unit of work, and domain events.

            All value objects are immutable and self-validating. The package is
            independent of heavy frameworks like ASP.NET Core or Entity Framework Core,
            making it usable in any .NET application (Console, WPF, MAUI, Web API, etc.).
        </Description>

        <!-- Tags to improve discoverability in NuGet search -->
        <PackageTags>ddd;clean-architecture;domain;abstractions;value-objects;strongly-typed-id;auditing;repository;unit-of-work;entities;aggregate-root;marker-interfaces;phone-number;email;money;currency</PackageTags>

        <!-- AOT & Trimming Support -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>

        <!-- Instructs NuGet to use the specified file as the package README -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Files Included in the NuGet Package        -->
    <!-- ═══════════════════════════════════════════ -->
    <ItemGroup>
        <!-- 
            Locates the README file either in the 'docs' folder at the repository root
            or alongside the .csproj file, and packs it into the root of the NuGet package.
        -->
        <None Include="..\..\docs\KernelR.Domain\README.md" Pack="true" PackagePath="README.md" Condition="Exists('..\..\docs\KernelR.Domain\README.md')" />
    </ItemGroup>

    <!-- ═══════════════════════════════════════════ -->
    <!-- Project References                         -->
    <!-- ═══════════════════════════════════════════ -->
    <ItemGroup>
        <ProjectReference Include="..\KernelR.Patterns\KernelR.Patterns.csproj" />
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Entities\" />
    </ItemGroup>

</Project>