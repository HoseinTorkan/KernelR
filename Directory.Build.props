<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>        
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisMode>Recommended</AnalysisMode>
        <AnalysisLevel>latest</AnalysisLevel>

        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>        
    </PropertyGroup>

    <PropertyGroup>
        <!--<TreatWarningsAsErrors>true</TreatWarningsAsErrors>--> <!--TODO::-->

        <!--CA1711: "Identifiers should not have incorrect suffix"
            The rule warns when a type name ends with a "reserved" suffix
            such as Handler, Collection, Delegate, etc. It expects these
            suffixes to be used only for Microsoft-defined base types.

            Why disabled globally:
              1. In DDD and CQRS, "Handler" is standard terminology
                 (e.g., IDomainEventHandler, ICommandHandler).
              2. ASP.NET Core's built-in types (IHttpHandler) are unrelated.
              3. The rule produces false positives for every domain handler.-->
        <NoWarn>$(NoWarn);CA1711</NoWarn>
    </PropertyGroup>
    
    <!--Symbols & Source Link-->                      
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <!--
        Note (SDK 10+):
        SourceLink is bundled into the SDK. An explicit PackageReference to
        Microsoft.SourceLink.GitHub is therefore no longer required.
    -->
    <PropertyGroup>
        <EnableSourceLink>true</EnableSourceLink>
            <SourceLinkGitHubHost>github.com</SourceLinkGitHubHost>
    </PropertyGroup>

    <!--Deterministic Build-->
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <!--Repository & Author Metadata-->
    <PropertyGroup>
        <Authors>HoseinTorkan</Authors>
        <Company>KernelR</Company>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/HoseinTorkan/KernelR</RepositoryUrl>
        <PackageProjectUrl>https://github.com/HoseinTorkan/KernelR</PackageProjectUrl>
    </PropertyGroup>

    <!--Versioning (Centralized Default)-->
    <PropertyGroup>
        <Version Condition="'$(Version)' == ''">0.0.0-local</Version>
    </PropertyGroup>

    <!--Test Project Settings-->
    <PropertyGroup
        Condition=
        "$(MSBuildProjectName.EndsWith('.Tests'))
        Or $(MSBuildProjectName.EndsWith('.UnitTests'))
        Or $(MSBuildProjectName.EndsWith('.E2ETests'))">
        
        <IsTestProject>true</IsTestProject>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
</Project>
